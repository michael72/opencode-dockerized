# OpenCode Dockerized User Configuration
# 
# This file is auto-generated by setup.sh but can be edited manually.
# Location: ~/.config/opencode-dockerized/config
#
# Format:
#   setting.<name>=<value>                           # Settings (true/false)
#   mount.<name>=<host_path>:<container_path>[:<mode>]  # Volume mounts
#   env.<name>=<VARIABLE_NAME>                       # Environment variables
#
# Modes: "ro" (read-only, default) or "rw" (read-write)
# Paths: Use ~ for home directory (expanded at runtime)
# Vars: Must be uppercase with underscores, set in host environment

# ============================================
# Settings
# ============================================

# SSH Agent Forwarding
# Enables git over SSH support in the container without sharing actual keys.
# When enabled, this automatically:
#   - Mounts the SSH_AUTH_SOCK socket into the container
#   - Passes the SSH_AUTH_SOCK environment variable
# 
# This is the recommended way to use SSH in the container for git operations.
# No need to mount ~/.ssh or manually configure SSH_AUTH_SOCK.
#
# setting.ssh_agent_support=true

# OpenSpec Support (spec-driven development for AI coding assistants)
# When enabled, OpenSpec is available inside the container for spec-driven workflows.
# Run 'openspec init' in your project to get started.
# See: https://github.com/Fission-AI/OpenSpec/
#
# setting.openspec_support=true

# Approval-free /tmp access (OpenCode external_directory permission)
# Enabled by default. Without it OpenCode asks before any tool touches a path outside
# the project directory, /tmp included — a confirmation per scratch file, for state that
# lives and dies inside the container. Set to false to get those prompts back.
# The forwarded SSH agent socket (usually /tmp/ssh-XXXXXX/agent.NNN) stays excluded.
#
# setting.tmp_access_support=true

# Size cap for /tmp, which is mounted as a tmpfs
# Keeps a runaway write inside the container from filling the host's Docker storage.
# tmpfs is memory-backed: the cap is not a reservation, but what is written occupies
# RAM and swap — size it against the host's memory. Accepts e.g. 32g, 8g, 4096m, or
# "off" to leave /tmp on the container's writable layer.
#
# setting.tmp_size=32g

# Matt Pocock's agent skills (grilling, TDD, code review, domain modelling, ...)
# When enabled, the skills baked into the image are copied to ~/.agents/skills inside
# the container on every launch, where OpenCode discovers them for every project.
# Each skill also becomes a slash command; run /setup-matt-pocock-skills once per
# repository before using the engineering skills.
# See: https://github.com/mattpocock/skills
#
# setting.matt_pocock_skills_support=true

# ============================================
# Custom Volume Mounts
# ============================================
# Syntax: mount.<name>=<host_path>:<container_path>[:<mode>]
#
# Mounts are read-only by default. Append :rw for read-write access.
#
# Common examples:
#   mount.gitconfig=~/.gitconfig:/home/coder/.gitconfig
#   mount.gradle=~/.gradle/gradle.properties:/home/coder/.gradle/gradle.properties
#
# mount.gitconfig=~/.gitconfig:/home/coder/.gitconfig

# ============================================
# Environment Variables
# ============================================
# Syntax: env.<name>=<VARIABLE_NAME>
#
# These variables are passed from your host environment to the container.
# Only variables that are set in your host environment will be passed.
# If a variable is not set on the host, it will be skipped with a warning.
#
# Useful for:
#   - API keys and tokens
#   - Build-related variables
#
# Common examples:
#   env.context7=CONTEXT7_API_KEY             # Context7 API key
#   env.aws_bedrock=AWS_BEARER_TOKEN_BEDROCK  # AWS Bedrock credentials
#   env.slim_tools=OPENCODE_SLIM_TOOLS        # Condensed tool descriptions
#                                             # (see config/opencode/plugin/README.md)
#
# env.context7=CONTEXT7_API_KEY
# env.aws_bedrock=AWS_BEARER_TOKEN_BEDROCK
